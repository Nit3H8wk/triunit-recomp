# The user's own replacement audio stays local; only the folder skeleton is versioned.
custom_audio/**
!custom_audio/**/
!custom_audio/**/.gitkeep
!custom_audio/**/README_AUDIO.txt

# The user's own game frame image stays local.
custom_bezel/

# Save states are tied to the user's own ROM.
saves/

# Regenerable local knowledge graph (not source or test evidence).
/graphify-out/

# Local workspace, never published: agent instructions and skills, resume notes, internal plans, graph config.
/AGENTS.md
/CLAUDE.md
/CONTINUAR-AQUI.md
/.codex/
/.claude/
/.graphifyrc
/.graphifyignore
/docs/GRAPHIFY.md
/docs/superpowers/
